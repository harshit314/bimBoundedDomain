Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "set", " ", "normal", " ", "vectors", " ", "associated", " ", "with", " ", 
    "each", " ", "collocation", " ", 
    RowBox[{"point", ":", " ", 
     RowBox[{"eTheta", " ", "x", " ", "ePhi"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rCVec", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"borderFn", "[", "y", "]"}], " ", 
        RowBox[{"Cos", "[", "phi", "]"}]}], ",", "y", ",", 
       RowBox[{
        RowBox[{"borderFn", "[", "y", "]"}], " ", 
        RowBox[{"Sin", "[", "phi", "]"}]}]}], "}"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"for", " ", "spheroids"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eCTheta", "=", 
     RowBox[{"D", "[", 
      RowBox[{"rCVec", ",", "y"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eCPhi", "=", 
     RowBox[{"D", "[", 
      RowBox[{"rCVec", ",", "phi"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nCVec", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Cross", "[", 
        RowBox[{"eCTheta", ",", "eCPhi"}], "]"}]}], "//", "Simplify"}]}], 
    ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"not", " ", "a", " ", "unit", " ", "vector"}], "..."}], "its", " ",
      "magnitude", " ", "carry", " ", "jacobian", " ", "factor"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.901190991169714*^9, 3.901191019416046*^9}, {
   3.901191320264526*^9, 3.901191322507501*^9}, {3.90119135792776*^9, 
