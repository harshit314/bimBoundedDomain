Cell[BoxData[
 RowBox[{
  RowBox[{"tstFn", "[", "x_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "100"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"3", "/", "10"}]}], ")"}], "^", "2"}]}], ")"}]}], "+", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "25"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"9", "/", "10"}]}], ")"}], "^", "2"}]}], ")"}]}], "-", 
    "6"}], ")"}]}]], "Input",
