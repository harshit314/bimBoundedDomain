Cell[BoxData[
 RowBox[{
  RowBox[{"boxNormalVec", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"nCVec", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"y", "->", 
          RowBox[{"parametricPt", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"phi", "->", 
          RowBox[{"parametricPt", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", 
