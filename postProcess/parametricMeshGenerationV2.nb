Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "set", " ", "normal", " ", "vectors", " ", "associated", " ", "with", " ", 
    "each", " ", "collocation", " ", 
    RowBox[{"point", ":", " ", 
     RowBox[{"eTheta", " ", "x", " ", "ePhi"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rVec", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ar", " ", 
        RowBox[{"Sin", "[", "theta", "]"}], " ", 
        RowBox[{"Cos", "[", "phi", "]"}]}], ",", 
       RowBox[{"ar", " ", 
        RowBox[{"Sin", "[", "theta", "]"}], " ", 
        RowBox[{"Sin", "[", "phi", "]"}]}], ",", 
       RowBox[{"Cos", "[", "theta", "]"}]}], "}"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"for", " ", "spheroids"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eTheta", "=", 
     RowBox[{"D", "[", 
      RowBox[{"rVec", ",", "theta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ePhi", "=", 
     RowBox[{"D", "[", 
      RowBox[{"rVec", ",", "phi"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nVec", "=", 
     RowBox[{
      RowBox[{"Cross", "[", 
       RowBox[{"eTheta", ",", "ePhi"}], "]"}], "//", "Simplify"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"not", " ", "a", " ", "unit", " ", "vector"}], "..."}], "its", " ",
      "magnitude", " ", "carry", " ", "jacobian", " ", "factor"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.901190991169714*^9, 3.901191019416046*^9}, {
