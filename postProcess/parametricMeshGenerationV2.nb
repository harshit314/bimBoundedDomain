Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symboliclegendre", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"LegendreP", "[", 
      RowBox[{"n", ",", "x"}], "]"}], "==", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"legendreprime", "[", 
    RowBox[{"n_", ",", "a_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"LegendreP", "[", 
       RowBox[{"n", ",", "x"}], "]"}], ",", "x"}], "]"}], "/.", " ", 
    RowBox[{"x", "->", "a"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"weights", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   FractionBox["2", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"x", "^", "2"}]}], ")"}], " ", 
     RowBox[{
      RowBox[{"legendreprime", "[", 
       RowBox[{"n", ",", "x"}], "]"}], "^", "2"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.901186513197888*^9, 3.9011865493616548`*^9}, {
   3.90118665538138*^9, 3.901186705624596*^9}, {3.901187378815199*^9, 
